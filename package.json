{
  "name": "corx",
  "description": "A simple CORS proxy - with body support and optional origin host restriction",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build src/index.ts --target=bun --outfile corx",
    "start": "bun --bun run src/index.ts",
    "dev": "bun --bun run --watch src/index.ts",
    "typecheck": "bun run --noEmit src/index.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260420.1",
    "@types/bun": "latest",
    "cross-env": "^10.1.0",
    "wrangler": "^4.83.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "ioredis": "^5.11.0",
    "unstorage": "^1.17.5",
    "zod": "^4.3.6"
  }
}
