{
  "name": "corx",
  "description": "A simple CORS proxy - with body support and optional origin host restriction",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun --bun build src/index.ts --outfile corx",
    "start": "bun --bun run src/index.ts",
    "dev": "bun --bun run --watch src/index.ts",
    "typecheck": "bun run --noEmit src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "cross-env": "^10.1.0",
    "wrangler": "^4.78.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
